# Brings the public server's /volunteer/ to this machine, when volunteers fetch YouTube videos for a server other than
# the public one (README, "Volunteers"): Caddy there passes /volunteer/ to a Unix socket in its data/tunnel/, which this
# SSH connection forwards to this machine's volunteer port. Nothing else here is reachable through it.
# It runs with no one logged in, so it needs a key of its own with no passphrase, which the public server accepts for
# forwarding only, and that server's sshd must replace a socket left from the last connection. README has the steps.
# Edit User, HOST, KEY and SOCKET (in the repository there: data/tunnel/volunteer.sock), then:
#     sudo cp deploy/volunteer-tunnel.service /etc/systemd/system/ && sudo systemctl enable --now volunteer-tunnel
[Unit]
Description=BoulderMesh volunteers: SSH tunnel from the public server
After=network-online.target
Wants=network-online.target

[Service]
User=tom
Environment=HOST=tom@178.105.53.11 KEY=/home/tom/.ssh/bouldermesh_tunnel SOCKET=/home/tom/bouldermesh/data/tunnel/volunteer.sock LOCAL_PORT=47613
ExecStart=/usr/bin/ssh -N -i ${KEY} -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R ${SOCKET}:127.0.0.1:${LOCAL_PORT} ${HOST}
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
