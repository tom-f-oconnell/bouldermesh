# Lends this machine to a BoulderMesh server for reconstructions, when the server can't reach it (README, "Running
# reconstructions elsewhere"): worker/bouldermesh_worker.py asks the server for climbs to mesh over HTTPS, and runs them
# in Docker. Run the script once by hand first, with the server and the token from its admin page, which it remembers:
#     python3 worker/bouldermesh_worker.py --server https://boulders.example.com --token bmw_... --cpus 12 \
#         --data /data/you/bouldermesh-worker --check
# (--data: where jobs' photos and results, and the models they download, go, if not in ~/.bouldermesh-worker)
# Then edit User and SCRIPT below, and:
#     sudo cp deploy/bouldermesh-worker.service /etc/systemd/system/ && sudo systemctl enable --now bouldermesh-worker
# journalctl -u bouldermesh-worker -f shows what it's doing. Stopping it gives the climb it was on back to the server.
[Unit]
Description=BoulderMesh: reconstructions for a server that can't reach this machine
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=tom
Environment=SCRIPT=/home/tom/src/bouldermesh/worker/bouldermesh_worker.py
ExecStart=/usr/bin/python3 ${SCRIPT}
Restart=always
RestartSec=60
# 3: the server won't take its token or this script (it says why, and what to do): starting again won't help
RestartPreventExitStatus=3
# a job's container is ended by the script when it stops, which takes a few seconds
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
