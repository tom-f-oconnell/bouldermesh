# BoulderMesh behind Caddy, for docker-compose.public.yml: HTTPS for SITE_HOST with a Let's Encrypt certificate, which
# Caddy gets and renews by itself, compression, and an access log to Caddy's output (docker compose logs caddy).
# WWW_HOST, if set (www.example.com, also pointed at this machine), gets a certificate too and redirects to SITE_HOST.
#
# Behind Cloudflare's proxy every connection comes from one of its addresses. These options believe those addresses
# (cloudflare.com/ips, as of Nov 2026; they change rarely) when they name the visitor in CF-Connecting-IP, so the access
# log's client_ip is the visitor's (remote_ip stays Cloudflare's), and so is X-Real-IP, which the app logs. Without
# Cloudflare they change nothing, as no other sender's header is believed.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_HOST} {$WWW_HOST:} {
	encode zstd gzip
	log
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@alias not host {$SITE_HOST}
	redir @alias https://{$SITE_HOST}{uri} permanent
	# To refuse every change at the edge as well, even with the editing token, uncomment these two lines:
	# @write not method GET HEAD OPTIONS
	# respond @write `{"error": "this copy of the site is view-only"}` 405
	request_body {
		max_size {$MAX_BODY:1100MB}
	}
	reverse_proxy bouldermesh:8470 {
		header_up X-Real-IP {client_ip}
	}
}
